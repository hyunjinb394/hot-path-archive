{
  "name": "hot-path-archive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n content,next \"velite dev\" \"next dev -p 3100\"",
    "build": "velite build && next build",
    "new": "tsx scripts/new-post.ts",
    "test": "vitest run",
    "typecheck": "velite build && tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "velite": "0.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.20.0"
}
